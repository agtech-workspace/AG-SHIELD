# Core Supabase Connection
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL for auth redirects
VITE_SUPABASE_SITE_URL=http://localhost:5173
VITE_AUTH_REDIRECT_URL=http://localhost:5173/dashboard

# Auth mode: set to 'demo' to disconnect Supabase auth for testing
# (login + CAC checks run locally with sandbox data, no API keys needed).
# Leave unset or remove for live Supabase auth.
VITE_AUTH_MODE=

# Google OAuth - configure in Supabase Dashboard
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# For Vercel automatic migrations (run: npx supabase login)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=  # Add in Vercel dashboard, not here

# Paystack live secret key (server-side only — never exposed to client)
# Also set PAYSTACK_SECRET_KEY in the Supabase Edge Function env.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Server-side aliases for the cron workers (cron/env.py loads .env.local).
# SUPABASE_SERVICE_ROLE_KEY is the same key as the Edge Function secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Account name resolution (bank/verify) — cache-first strategy
# RESOLVE_PROVIDER: paystack | nubapi | auto (paystack first)
RESOLVE_PROVIDER=paystack
NUBAPI_TOKEN=your-nubapi-bearer-token
# bank_lookup_cache freshness window (hours)
RESOLVE_CACHE_TTL_HOURS=72

# Supabase Edge Function URLs
VITE_RESOLVE_EDGE_URL=https://your-project-ref.supabase.co/functions/v1/resolve-account
VITE_RISK_CHECK_EDGE_URL=https://your-project-ref.supabase.co/functions/v1/risk-check
VITE_VERIFY_CAC_EDGE_URL=https://your-project-ref.supabase.co/functions/v1/verify-cac

# CAC verification provider (Prembly by default, provider-agnostic).
# Only these secrets are sent to the edge function env (never exposed to client).
CAC_PROVIDER=prembly
PREMBLY_API_URL=https://api.prembly.com
PREMBLY_API_TOKEN=your-prembly-api-token
DOJAH_APP_ID=your-dojah-app-id-optional
DOJAH_API_SECRET=your-dojah-api-secret-optional

# B2B tenant bootstrap (first tenant seeded during deployment)
VITE_B2B_TENANT_API_KEY=your-tenant-api-key
